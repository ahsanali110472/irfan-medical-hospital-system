{
  "name": "hms-electron-mern",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "description": "Hospital Management & Billing System (MERN + Electron)",
  "author": "Try Unity Solutions",
  "license": "MIT",
  "scripts": {
    "postinstall": "cd backend && npm install && cd ../frontend && npm install && cd ..",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:electron\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.js",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:electron": "node build-electron.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:all": "electron-builder --win --mac --linux",
    "seed": "cd backend && npm run seed"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.8",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "node-thermal-printer": "^4.5.0",
    "usb": "^2.16.0"
  },
  "build": {
    "appId": "com.tryunitysolutions.hms",
    "productName": "Irfan Medical Center HMS",
    "files": [
      "electron/**",
      "frontend/dist/**",
      "backend/**",
      "package.json",
      "!backend/logs",
      "backend/.env.example"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "buildResources": "electron/build"
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "sign": null
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "warningsAsErrors": false
    },
    "asar": true,
    "asarUnpack": [
      "backend/**/*",
      "electron/backend-launcher.cjs"
    ],
    "afterPack": "./scripts/after-pack.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.com/updates/"
      }
    ]
  }
}
